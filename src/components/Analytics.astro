---
/**
 * Google Analytics 4 (gtag.js) tag.
 *
 * Loads on every page via BaseLayout's <head>. Guarded so it only runs on the real
 * production site:
 *   - `PUBLIC_GA_MEASUREMENT_ID` must be set (see netlify.toml / .env.example).
 *   - Netlify's `CONTEXT` must be "production" (excludes deploy previews & branch deploys).
 *     When CONTEXT is absent (e.g. plain `astro build` locally) we fall back to import.meta.env.PROD.
 * This keeps local dev and preview traffic out of your analytics data.
 */
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();

const deployContext = process.env.CONTEXT;
const isProductionDeploy = deployContext ? deployContext === 'production' : import.meta.env.PROD;

const enabled = Boolean(measurementId) && isProductionDeploy;
---

{
  enabled && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`} />
      <script define:vars={{ measurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', measurementId);
      </script>
    </>
  )
}
