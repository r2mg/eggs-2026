---
/** Shared footer. */
import footerLogo from '../imports/eggs-transparent-org@4x.png';
import { SITE } from '../data/content';

const listen = SITE.listen;
const linkClass =
  'inline-flex min-h-10 items-center justify-center md:justify-start w-full md:w-auto py-1 hover:text-foreground transition-colors';
const listenLinkClass = `${linkClass} gap-2.5`;
const socialClass =
  'inline-flex min-h-10 items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors px-1';

/** Listen destinations with brand-colored logos. */
const listenLinks = [
  { id: 'spotify', href: listen.spotify, label: 'Spotify', color: '#1DB954' },
  { id: 'apple', href: listen.apple, label: 'Apple Podcasts', color: 'currentColor' },
  { id: 'youtube', href: listen.youtube, label: 'YouTube', color: '#FF0000' },
  { id: 'rss', href: listen.rss, label: 'RSS Feed', color: '#F26522' },
];

/** Social profiles — monochrome logos (inherit the link's text color). */
const socialLinks = [
  { id: 'twitter', href: 'https://x.com/eggsthepodcast', label: 'Twitter' },
  { id: 'instagram', href: 'https://www.instagram.com/eggsthepodcast', label: 'Instagram' },
  { id: 'linkedin', href: 'https://www.linkedin.com/company/18690625/', label: 'LinkedIn' },
];

/** Brand glyphs (Simple Icons paths), 24×24 viewBox, filled with currentColor. */
function iconSvg(id: string): string {
  const open = '<svg class="w-[18px] h-[18px] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">';
  const paths: Record<string, string> = {
    spotify:
      '<path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.42 1.56-.299.421-1.02.599-1.559.3z"/>',
    apple:
      '<path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701z"/>',
    youtube:
      '<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>',
    rss:
      '<path d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415a3.3 3.3 0 0 0-3.291 3.295 3.303 3.303 0 0 0 3.291 3.29 3.303 3.303 0 0 0 3.295-3.29 3.303 3.303 0 0 0-3.295-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z"/>',
    twitter:
      '<path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/>',
    instagram:
      '<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>',
    linkedin:
      '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>',
  };
  return `${open}${paths[id] ?? ''}</svg>`;
}
---

<footer class="border-t border-border py-10 sm:py-14 md:py-16 bg-background">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 lg:gap-24 mb-10 md:mb-12">
      <div class="flex justify-center md:justify-start">
        <img src={footerLogo.src} alt="EGGS! The Podcast" class="h-20 sm:h-24 md:h-28 lg:h-32 w-auto max-w-full object-contain" />
      </div>

      <div class="grid grid-cols-1 gap-10 text-center md:text-left">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6 md:gap-10">
          <div>
            <h4 class="font-medium mb-3 sm:mb-4 text-base">Episodes</h4>
            <ul class="space-y-1 sm:space-y-2 text-sm text-muted-foreground">
              <li><a href="/" class={linkClass}>Latest</a></li>
              <li><a href="/episodes" class={linkClass}>Archive</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-medium mb-3 sm:mb-4 text-base">About</h4>
            <ul class="space-y-1 sm:space-y-2 text-sm text-muted-foreground">
              <li><a href="/about" class={linkClass}>About the Show</a></li>
              <li><a href="/be-a-guest" class={linkClass}>Be a Guest</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-medium mb-3 sm:mb-4 text-base">Listen</h4>
            <ul class="space-y-1 sm:space-y-2 text-sm text-muted-foreground">
              {
                listenLinks.map((s) => (
                  <li>
                    <a href={s.href} target="_blank" rel="noopener noreferrer" class={listenLinkClass}>
                      <span class="shrink-0 inline-flex" style={`color: ${s.color}`} set:html={iconSvg(s.id)} />
                      {s.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 pt-8 border-t border-border">
      <p class="text-sm text-muted-foreground text-center sm:text-left order-2 sm:order-1">
        © 2026 EGGS! The Podcast. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center justify-center sm:justify-end gap-x-4 sm:gap-x-6 gap-y-2 order-1 sm:order-2">
        {
          socialLinks.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class={socialClass}>
              <span class="shrink-0 inline-flex" set:html={iconSvg(s.id)} />
              {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
