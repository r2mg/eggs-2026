---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteContent } from '../../data/content';
import { guestPath } from '../../lib/display';

const { guests } = await getSiteContent();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'EGGS! Podcast Guests',
  description: `Browse all ${guests.length} guests who have appeared on EGGS! The Podcast.`,
  url: new URL('/guests', Astro.site ?? 'https://eggscast.com').href,
};
---

<BaseLayout
  title="Guests"
  description={`Browse all ${guests.length} guests who have appeared on EGGS! The Podcast — creative professionals, entrepreneurs, and industry leaders.`}
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-background pt-16">
    <section class="pt-12 sm:pt-20 md:pt-24 pb-8 sm:pb-12 bg-gradient-to-b from-accent/5 to-background">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 min-w-0">
        <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl mb-3 sm:mb-6 break-words" style="font-family: var(--font-display); font-weight: 700;">Guests</h1>
        <p class="text-sm sm:text-lg md:text-xl lg:text-2xl text-muted-foreground max-w-3xl leading-relaxed">
          The creative professionals, entrepreneurs, and industry leaders who have joined us on EGGS!
          <span class="text-foreground font-medium">{guests.length} guests</span> and counting.
        </p>
      </div>
    </section>

    <section class="py-8 sm:py-14 md:py-16">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 min-w-0">
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-1">
          {
            guests.map((guest) => (
              <li>
                <a href={guestPath(guest.slug)} class="group flex items-baseline justify-between gap-4 py-3 border-b border-border hover:border-accent transition-colors">
                  <span class="text-base sm:text-lg group-hover:text-accent transition-colors break-words" style="font-family: var(--font-display); font-weight: 600;">{guest.name}</span>
                  <span class="text-sm text-muted-foreground shrink-0 tabular-nums">{guest.episodes.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
