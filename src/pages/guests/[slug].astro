---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { getSiteContent } from '../../data/content';
import { guestPath } from '../../lib/display';

import { resolveSiteOrigin } from '../../lib/siteOrigin';

export async function getStaticPaths() {
  const { guests } = await getSiteContent();
  return guests.map((guest) => ({ params: { slug: guest.slug }, props: { guest } }));
}

const { guest } = Astro.props;
const siteOrigin = resolveSiteOrigin(Astro.site);
const count = guest.episodes.length;
const canonical = new URL(guestPath(guest.slug), siteOrigin).href;
const description = `${guest.name} on EGGS! The Podcast — ${count} ${count === 1 ? 'episode' : 'episodes'} exploring creativity, entrepreneurship, and the people behind interesting work.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: guest.name,
    url: canonical,
    description: `Guest on EGGS! The Podcast (${count} ${count === 1 ? 'appearance' : 'appearances'}).`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteOrigin.href },
      { '@type': 'ListItem', position: 2, name: 'Episodes', item: new URL('/episodes', siteOrigin).href },
      { '@type': 'ListItem', position: 3, name: guest.name, item: canonical },
    ],
  },
];
---

<BaseLayout title={guest.name} description={description} jsonLd={jsonLd}>
  <main class="min-h-screen bg-background pt-16">
    <section class="pt-12 sm:pt-20 md:pt-24 pb-8 sm:pb-12 bg-gradient-to-b from-accent/5 to-background">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 min-w-0">
        <div class="flex flex-wrap items-center gap-x-2 text-sm text-muted-foreground mb-6">
          <a href="/episodes" class="inline-flex min-h-11 items-center py-1 -ml-1 px-1 rounded-sm hover:text-foreground transition-colors">← All Episodes</a>
        </div>
        <p class="text-[0.65rem] sm:text-sm text-accent font-medium mb-2 sm:mb-4 tracking-wider uppercase">Guest</p>
        <h1 class="text-4xl sm:text-6xl md:text-7xl mb-3 sm:mb-5 break-words" style="font-family: var(--font-display); font-weight: 700;">{guest.name}</h1>
        <p class="text-base sm:text-xl text-muted-foreground">{count} {count === 1 ? 'episode' : 'episodes'} on EGGS!</p>
      </div>
    </section>

    <section class="py-8 sm:py-14 md:py-16">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 min-w-0">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8">
          {guest.episodes.map((ep) => <EpisodeCard episode={ep} />)}
        </div>
      </div>
    </section>

    <section class="py-12 sm:py-16 md:py-24 bg-[#FFF5EE]">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 min-w-0">
        <a href="/be-a-guest" class="block max-w-2xl mx-auto">
          <div class="p-8 sm:p-12 md:p-16 bg-white border-2 border-accent relative overflow-hidden group h-full">
            <div class="absolute -top-12 -right-12 w-48 h-48 bg-accent/10 rounded-full group-hover:scale-150 transition-transform duration-500"></div>
            <h3 class="text-3xl sm:text-4xl md:text-5xl mb-6 relative z-10" style="font-family: var(--font-display); font-weight: 600;">Be a Guest</h3>
            <p class="text-lg text-muted-foreground mb-10 leading-relaxed relative z-10">Have a story worth sharing? We'd love to hear from you.</p>
            <span class="text-accent font-medium inline-flex items-center gap-2 text-lg relative z-10 group-hover:gap-4 transition-all">Apply Now →</span>
          </div>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
