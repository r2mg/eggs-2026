---
import BaseLayout from '../layouts/BaseLayout.astro';

const differentiators = [
  { title: 'Depth Over Surface', description: 'We go beyond the highlight reel. Our conversations explore the messy middle, the strategic decisions, and the real challenges behind successful creative work.' },
  { title: 'Practitioners, Not Pundits', description: 'Every guest is actively building, creating, or leading. We feature people doing the work, not just talking about it.' },
  { title: 'Strategy Meets Craft', description: 'We bridge the gap between business and creativity. The best work happens when strategic thinking meets exceptional craft—we explore both.' },
];

const topics = [
  'Entrepreneurship', 'Branding & Identity', 'Creative Practice', 'Business Strategy',
  'Design & Technology', 'Culture & Storytelling', 'Leadership', 'Craft & Expertise',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About EGGS! The Podcast',
  url: new URL('/about', Astro.site ?? 'https://eggscast.com').href,
};
---

<BaseLayout
  title="About"
  description="EGGS! is a podcast exploring creativity, entrepreneurship, branding, and the people behind interesting work — hosted by Ryan Roghaar and Mike Smith."
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-background pt-16 overflow-x-hidden">
    <section class="py-12 sm:py-16 md:py-24 bg-gradient-to-b from-accent/5 to-background">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 min-w-0">
        <div class="max-w-4xl">
          <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl mb-6 sm:mb-8 leading-tight break-words" style="font-family: var(--font-display); font-weight: 700;">About EGGS!</h1>
          <p class="text-lg sm:text-2xl md:text-3xl text-muted-foreground leading-relaxed">A podcast exploring creativity, entrepreneurship, branding, and the people behind interesting work.</p>
        </div>
      </div>
    </section>

    <section class="py-12 sm:py-16 md:py-24 bg-background">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 min-w-0">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 lg:gap-24 items-start">
          <div>
            <h2 class="text-3xl sm:text-4xl md:text-5xl mb-6 sm:mb-8" style="font-family: var(--font-display); font-weight: 600;">What is EGGS!?</h2>
            <div class="w-24 h-1 bg-accent mb-8"></div>
          </div>
          <div class="space-y-6">
            <p class="text-base sm:text-xl text-muted-foreground leading-relaxed">EGGS! is a podcast that sits down with creative professionals, entrepreneurs, designers, and builders to unpack the stories, strategies, and insights behind their work.</p>
            <p class="text-base sm:text-xl text-muted-foreground leading-relaxed">We're interested in the intersection of craft and commerce, creativity and systems, intuition and strategy. Each episode digs into how people build sustainable creative practices, navigate industry changes, and maintain their vision while growing their impact.</p>
            <p class="text-base sm:text-xl text-muted-foreground leading-relaxed">Whether you're starting your first project or scaling your tenth company, EGGS! brings you conversations that challenge assumptions and offer practical wisdom from people who've done the work.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 sm:py-16 md:py-24 bg-muted/30">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 min-w-0">
        <h2 class="text-3xl sm:text-4xl md:text-5xl mb-10 sm:mb-16 text-center" style="font-family: var(--font-display); font-weight: 600;">What Makes EGGS! Different</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-10 md:gap-12">
          {
            differentiators.map((item) => (
              <div class="p-6 sm:p-10 bg-background border-2 border-border hover:border-accent transition-colors">
                <h3 class="text-2xl mb-4" style="font-family: var(--font-display); font-weight: 600;">{item.title}</h3>
                <p class="text-lg text-muted-foreground leading-relaxed">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="py-12 sm:py-16 md:py-24 bg-background">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 min-w-0">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 lg:gap-24">
          <div>
            <h2 class="text-3xl sm:text-4xl md:text-5xl mb-6 sm:mb-8 leading-tight" style="font-family: var(--font-display); font-weight: 600;">Conversations We Have</h2>
            <p class="text-xl text-muted-foreground leading-relaxed">EGGS! explores the themes that matter most to people building creative careers and businesses in a rapidly changing landscape.</p>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:gap-4 min-w-0">
            {
              topics.map((topic) => (
                <div class="p-4 sm:p-6 border-2 border-border hover:border-accent hover:bg-accent/5 transition-all min-h-[3.25rem]">
                  <span class="text-base font-medium">{topic}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 sm:py-16 md:py-24 bg-accent text-white">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 min-w-0">
        <div class="max-w-3xl">
          <p class="text-sm tracking-widest mb-4 text-white/70 uppercase">Hosts</p>
          <h2 class="text-3xl sm:text-4xl md:text-5xl mb-6" style="font-family: var(--font-display); font-weight: 600;">Ryan Roghaar & Mike Smith</h2>
          <p class="text-xl text-white/90 mb-6 leading-relaxed">EGGS! is hosted by Ryan Roghaar and Mike "DJ Ontic" Smith — bringing curiosity, design and branding expertise, and a love of good conversation to every episode.</p>
          <p class="text-lg text-white/80 leading-relaxed">The show is an extension of their work helping brands and creative businesses tell better stories — a space to learn from the people shaping creative industries.</p>
        </div>
      </div>
    </section>

    <section class="py-12 sm:py-16 md:py-24 bg-[#FFF5EE]">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 min-w-0">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
          <a href="/be-a-guest" class="block h-full">
            <div class="p-8 sm:p-12 md:p-16 bg-white border-2 border-accent relative overflow-hidden group h-full">
              <div class="absolute -top-12 -right-12 w-48 h-48 bg-accent/10 rounded-full group-hover:scale-150 transition-transform duration-500"></div>
              <h3 class="text-3xl sm:text-4xl md:text-5xl mb-6 relative z-10" style="font-family: var(--font-display); font-weight: 600;">Be a Guest</h3>
              <p class="text-lg text-muted-foreground mb-10 leading-relaxed relative z-10">Have a story worth sharing? We'd love to hear from you.</p>
              <span class="text-accent font-medium inline-flex items-center gap-2 text-lg relative z-10 group-hover:gap-4 transition-all">Apply Now →</span>
            </div>
          </a>
          <a href="/sponsor" class="block h-full">
            <div class="p-8 sm:p-12 md:p-16 bg-accent text-white relative overflow-hidden group h-full">
              <div class="absolute -bottom-12 -left-12 w-64 h-64 bg-white/10 rounded-full group-hover:scale-150 transition-transform duration-500"></div>
              <h3 class="text-3xl sm:text-4xl md:text-5xl mb-6 relative z-10" style="font-family: var(--font-display); font-weight: 600;">Sponsor EGGS!</h3>
              <p class="text-lg text-white/90 mb-10 leading-relaxed relative z-10">Reach our audience of creative professionals and entrepreneurs.</p>
              <span class="text-white font-medium inline-flex items-center gap-2 text-lg relative z-10 group-hover:gap-4 transition-all">Learn More →</span>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
