# Copy this file to `.env` in the repo root and fill in values.
# `.env` is gitignored — never commit real keys.

# Optional: enables YouTube thumbnails, featured order, topic groupings, and episode overlays.
# Used at BUILD time (server-side), so it is never shipped to the browser.
# In Google Cloud Console: Application restrictions = None (or IP), API restrictions = YouTube Data API v3.
YOUTUBE_API_KEY=

# Canonical production origin (sitemap, canonical tags, Open Graph). Override per environment.
# PUBLIC_SITE_URL=https://eggsthepodcast.com

# Google Analytics 4 measurement ID. Set in netlify.toml for production; analytics only
# fires on the live production deploy, so you normally leave this unset locally.
# PUBLIC_GA_MEASUREMENT_ID=G-8LB7KFGQZN

# Legacy fallback (still read if YOUTUBE_API_KEY is unset). Prefer YOUTUBE_API_KEY above.
# VITE_YOUTUBE_API_KEY=
